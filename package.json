{
  "name": "yellowcode",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "bun src/index.tsx",
    "record": "bun tools/record/record.ts",
    "transcripts": "bun tools/record/transcripts.ts",
    "flicker": "bun tools/flicker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings --disable-nested-config",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test"
  },
  "dependencies": {
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "marked": "17.0.1",
    "solid-js": "1.9.12",
    "web-tree-sitter": "0.25.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "@types/bun": "^1.4.2",
    "eslint-plugin-solid": "0.18.1",
    "oxfmt": "^0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2"
  }
}
