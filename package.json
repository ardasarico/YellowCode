{
  "name": "yellowcode",
  "version": "0.3.0-beta.2",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "Arda Sarı",
  "bin": {
    "yellowcode": "bin/yellowcode"
  },
  "type": "module",
  "exports": {
    "./mod": {
      "types": "./types/mod.d.ts",
      "default": "./src/mods/api.ts"
    }
  },
  "scripts": {
    "dev": "bun src/index.tsx",
    "record": "bun tools/record/record.ts",
    "transcripts": "bun tools/record/transcripts.ts",
    "tour": "bun tools/record/tour.ts",
    "flicker": "bun tools/flicker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings --disable-nested-config",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "types": "bun tools/mod-types.ts",
    "parsers": "bun node_modules/@opentui/core/lib/tree-sitter/update-assets.js --config tools/parsers-config.json --assets src/ui/markdown/parsers --output src/ui/markdown/parsers/parsers.ts",
    "types:check": "bun tools/mod-types.ts --check",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run types:check && bun test",
    "build": "bun tools/build.ts",
    "build:check": "bun tools/build-check.ts",
    "release": "bun tools/release.ts"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/client": "2.2.0",
    "@opentui/core": "0.6.8",
    "@opentui/solid": "0.6.8",
    "@resvg/resvg-js": "2.6.2",
    "babel-plugin-module-resolver": "5.0.2",
    "babel-preset-solid": "1.9.12",
    "grok-mermaid": "0.2.3",
    "jpeg-js": "0.4.4",
    "marked": "17.0.1",
    "solid-js": "1.9.12",
    "web-tree-sitter": "0.25.10",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "@types/bun": "^1.4.2",
    "eslint-plugin-solid": "0.18.1",
    "oxfmt": "^0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.3",
  "patchedDependencies": {
    "grok-mermaid@0.2.3": "patches/grok-mermaid@0.2.3.patch"
  }
}
